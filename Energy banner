<svg width="820" height="190" viewBox="0 0 820 190" xmlns="http://www.w3.org/2000/svg" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="flowGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#4c1d95">
        <animate attributeName="stop-color" values="#4c1d95;#7e22ce;#a855f7;#7e22ce;#4c1d95" dur="6s" repeatCount="indefinite"/>
      </stop>
      <stop offset="50%" stop-color="#a855f7">
        <animate attributeName="stop-color" values="#a855f7;#4c1d95;#7e22ce;#a855f7" dur="6s" repeatCount="indefinite"/>
      </stop>
      <stop offset="100%" stop-color="#7e22ce">
        <animate attributeName="stop-color" values="#7e22ce;#a855f7;#4c1d95;#7e22ce" dur="6s" repeatCount="indefinite"/>
      </stop>
    </linearGradient>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="5" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <!-- ola de energia de fondo, mas difusa -->
  <path d="M0,110 C90,50 180,170 270,110 C360,50 450,170 540,110 C630,50 720,170 810,120"
        fill="none" stroke="url(#flowGrad)" stroke-width="16" stroke-linecap="round" opacity="0.25" filter="url(#glow)"/>

  <!-- linea nucleo brillante -->
  <path id="corePath" d="M0,110 C90,50 180,170 270,110 C360,50 450,170 540,110 C630,50 720,170 810,120"
        fill="none" stroke="url(#flowGrad)" stroke-width="3.5" stroke-linecap="round" filter="url(#glow)">
    <animate attributeName="stroke-width" values="3.5;5;3.5" dur="2.4s" repeatCount="indefinite"/>
  </path>

  <!-- chispa viajando por la linea, como "codigo que fluye" -->
  <circle r="6" fill="#ffffff" filter="url(#glow)">
    <animateMotion dur="4.5s" repeatCount="indefinite" rotate="auto"
      path="M0,110 C90,50 180,170 270,110 C360,50 450,170 540,110 C630,50 720,170 810,120"/>
  </circle>
  <circle r="6" fill="#e9d5ff" filter="url(#glow)" opacity="0.7">
    <animateMotion dur="4.5s" begin="-2.2s" repeatCount="indefinite" rotate="auto"
      path="M0,110 C90,50 180,170 270,110 C360,50 450,170 540,110 C630,50 720,170 810,120"/>
  </circle>

  <!-- particulas / brasas ascendiendo -->
  <circle cx="90"  cy="70"  r="3" fill="#c084fc">
    <animate attributeName="cy" values="70;20;70" dur="3s" begin="0s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0;1;0" dur="3s" begin="0s" repeatCount="indefinite"/>
  </circle>
  <circle cx="230" cy="120" r="2.5" fill="#a855f7">
    <animate attributeName="cy" values="120;60;120" dur="3.6s" begin="0.6s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0;1;0" dur="3.6s" begin="0.6s" repeatCount="indefinite"/>
  </circle>
  <circle cx="380" cy="70"  r="3" fill="#e9d5ff">
    <animate attributeName="cy" values="70;15;70" dur="3.2s" begin="1.1s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0;1;0" dur="3.2s" begin="1.1s" repeatCount="indefinite"/>
  </circle>
  <circle cx="520" cy="130" r="2.5" fill="#c084fc">
    <animate attributeName="cy" values="130;75;130" dur="4s" begin="0.3s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0;1;0" dur="4s" begin="0.3s" repeatCount="indefinite"/>
  </circle>
  <circle cx="660" cy="75"  r="3" fill="#a855f7">
    <animate attributeName="cy" values="75;20;75" dur="3.4s" begin="0.9s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0;1;0" dur="3.4s" begin="0.9s" repeatCount="indefinite"/>
  </circle>
  <circle cx="750" cy="135" r="2.5" fill="#e9d5ff">
    <animate attributeName="cy" values="135;80;135" dur="3.8s" begin="1.4s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0;1;0" dur="3.8s" begin="1.4s" repeatCount="indefinite"/>
  </circle>
</svg>
