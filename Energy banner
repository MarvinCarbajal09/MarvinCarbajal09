<svg width="900" height="220" viewBox="0 0 900 220" xmlns="http://www.w3.org/2000/svg" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e1b4b"/>
      <stop offset="50%" stop-color="#4c1d95"/>
      <stop offset="100%" stop-color="#1e1b4b"/>
    </linearGradient>
    <radialGradient id="visorGrad" cx="35%" cy="30%" r="75%">
      <stop offset="0%" stop-color="#e9d5ff"/>
      <stop offset="55%" stop-color="#a855f7"/>
      <stop offset="100%" stop-color="#4c1d95"/>
    </radialGradient>
    <filter id="soft" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="4" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>

  <rect width="900" height="220" rx="14" fill="url(#bgGrad)" opacity="0.55"/>

  <!-- simbolos de codigo flotando de fondo -->
  <g font-family="JetBrains Mono, monospace" font-weight="600" fill="#c084fc">
    <text x="60"  y="60"  font-size="22" opacity="0.35">&lt;/&gt;</text>
    <text x="770" y="50"  font-size="20" opacity="0.3">{ }</text>
    <text x="120" y="170" font-size="18" opacity="0.3">01</text>
    <text x="810" y="150" font-size="22" opacity="0.35">;</text>
    <text x="40"  y="130" font-size="16" opacity="0.28">SQL</text>
    <text x="700" y="185" font-size="18" opacity="0.3">&lt;div&gt;</text>
    <text x="230" y="35"  font-size="16" opacity="0.25">const</text>
    <text x="620" y="35"  font-size="16" opacity="0.25">=&gt;</text>

    <animateTransform attributeName="transform" type="translate" values="0,6;0,-6;0,6" dur="7s" repeatCount="indefinite"/>
  </g>

  <!-- particulas / estrellas -->
  <circle cx="150" cy="40"  r="2" fill="#e9d5ff"><animate attributeName="opacity" values="0.1;1;0.1" dur="2.6s" repeatCount="indefinite"/></circle>
  <circle cx="500" cy="25"  r="1.6" fill="#c084fc"><animate attributeName="opacity" values="0.1;1;0.1" dur="3.2s" begin="0.4s" repeatCount="indefinite"/></circle>
  <circle cx="650" cy="190" r="2" fill="#e9d5ff"><animate attributeName="opacity" values="0.1;1;0.1" dur="2.8s" begin="0.8s" repeatCount="indefinite"/></circle>
  <circle cx="820" cy="80"  r="1.6" fill="#a855f7"><animate attributeName="opacity" values="0.1;1;0.1" dur="3s" begin="1.1s" repeatCount="indefinite"/></circle>
  <circle cx="90"  cy="190" r="1.8" fill="#c084fc"><animate attributeName="opacity" values="0.1;1;0.1" dur="3.4s" begin="0.5s" repeatCount="indefinite"/></circle>

  <!-- ===================== ASTRONAUTA (encima, semi-transparente) ===================== -->
  <g transform="translate(450,110)" opacity="0.92">
    <!-- deriva suave -->
    <animateTransform attributeName="transform" type="translate"
      values="450,110; 460,98; 450,110; 440,122; 450,110" dur="8s" repeatCount="indefinite" additive="sum" calcMode="linear"/>

    <g>
      <!-- ligero balanceo -->
      <animateTransform attributeName="transform" type="rotate" values="-4;4;-4" dur="6s" repeatCount="indefinite"/>

      <!-- mochila -->
      <rect x="-30" y="-18" width="24" height="60" rx="8" fill="#312e81" opacity="0.9"/>

      <!-- tubo de oxigeno -->
      <path d="M -20,-15 C -35,-25 -35,-45 -15,-52" stroke="#a855f7" stroke-width="4" fill="none" stroke-linecap="round" opacity="0.8"/>

      <!-- cuerpo -->
      <rect x="-28" y="-10" width="56" height="70" rx="24" fill="#f5f3ff" filter="url(#soft)"/>
      <rect x="-28" y="-10" width="56" height="70" rx="24" fill="none" stroke="#c084fc" stroke-width="2" opacity="0.6"/>

      <!-- panel de pecho -->
      <rect x="-12" y="14" width="24" height="16" rx="4" fill="#7e22ce" opacity="0.8"/>
      <circle cx="-4" cy="22" r="2" fill="#e9d5ff"><animate attributeName="opacity" values="0.3;1;0.3" dur="1.6s" repeatCount="indefinite"/></circle>
      <circle cx="4"  cy="22" r="2" fill="#e9d5ff"><animate attributeName="opacity" values="1;0.3;1" dur="1.6s" repeatCount="indefinite"/></circle>

      <!-- brazos -->
      <rect x="-46" y="0" width="18" height="34" rx="9" fill="#f5f3ff" transform="rotate(18)"/>
      <rect x="30"  y="-4" width="18" height="34" rx="9" fill="#f5f3ff" transform="rotate(-35 39 13)"/>

      <!-- piernas -->
      <rect x="-22" y="52" width="16" height="30" rx="8" fill="#f5f3ff" transform="rotate(-8)"/>
      <rect x="6"   y="52" width="16" height="30" rx="8" fill="#f5f3ff" transform="rotate(10)"/>

      <!-- casco -->
      <circle cx="0" cy="-38" r="26" fill="#f5f3ff" filter="url(#soft)"/>
      <circle cx="0" cy="-38" r="26" fill="none" stroke="#c084fc" stroke-width="2" opacity="0.6"/>
      <ellipse cx="-3" cy="-38" rx="17" ry="18" fill="url(#visorGrad)"/>
      <text x="-3" y="-33" font-family="JetBrains Mono, monospace" font-size="13" fill="#f5f3ff" text-anchor="middle" opacity="0.85">&lt;/&gt;</text>
      <ellipse cx="-9" cy="-46" rx="5" ry="3" fill="#ffffff" opacity="0.5"/>

      <!-- antena con luz -->
      <line x1="16" y1="-58" x2="20" y2="-70" stroke="#c084fc" stroke-width="2"/>
      <circle cx="20" cy="-70" r="3" fill="#e9d5ff">
        <animate attributeName="opacity" values="0.2;1;0.2" dur="1.4s" repeatCount="indefinite"/>
      </circle>

      <!-- laptop flotando en la mano, con lineas de codigo tipeando -->
      <g transform="translate(38,20)">
        <rect x="0" y="0" width="30" height="20" rx="3" fill="#1e1b4b" stroke="#a855f7" stroke-width="1.5"/>
        <rect x="3" y="4"  width="10" height="2.5" rx="1" fill="#c084fc"><animate attributeName="width" values="0;10;10;0" dur="3s" repeatCount="indefinite"/></rect>
        <rect x="3" y="9"  width="16" height="2.5" rx="1" fill="#a855f7"><animate attributeName="width" values="0;0;16;0" dur="3s" repeatCount="indefinite"/></rect>
        <rect x="3" y="14" width="8"  height="2.5" rx="1" fill="#e9d5ff"><animate attributeName="width" values="0;0;0;8" dur="3s" repeatCount="indefinite"/></rect>
      </g>
    </g>
  </g>
</svg>
